---
import AdSlot from '../../components/AdSlot.astro';
import DiagramThumb from '../../components/DiagramThumb.astro';
import Layout from '../../layouts/Layout.astro';
import { catalog } from '../../lib/catalog.mjs';
const categories = ['All', 'Genetics', 'Molecular', 'Cells', 'Ecology', 'Lab skills', 'Practice', 'Reference'];
---
<Layout title="Biology Calculators & Virtual Labs: All Free Tools" section="Tools" schemaType="CollectionPage" breadcrumbs={[['Tools', '/tools/']]} description="Every free biology calculator and virtual lab in one list: Punnett squares, DNA to mRNA, Hardy-Weinberg, population growth, SA:V ratio and water potential."><div class="intro"><div><div class="eyebrow">The complete toolkit</div><h1>Biology calculators and virtual labs</h1><p>Every free calculator, simulation and study tool in the Biology Lab, from a genetic cross to a growing population. Each one shows the formula, the worked steps and a live diagram. Search by topic or pick a category.</p></div></div><tool-catalog><div class="catalog-controls"><input type="search" aria-label="Search tools" placeholder="Search Punnett, DNA, enzymes, worksheets…" data-search/><div class="pills" aria-label="Tool category">{categories.map((c, i) => <button class:list={['pill', { selected: i === 0 }]} aria-pressed={i === 0} data-category={c}>{c}</button>)}</div></div><p class="catalog-count" data-count aria-live="polite">{catalog.length} tools and collections</p><div class="tool-grid">{catalog.map((t, i) => <><a class="tool-card" data-category={t.category} href={t.href} data-tool data-topic={t.category} data-text={`${t.title} ${t.description} ${t.category} ${t.keywords || ''}`.toLowerCase()}><div class="card-top"><span class="card-kicker">EXPLORE & UNDERSTAND</span><span class="badge">{t.category}</span></div><div class="card-diagram"><DiagramThumb kind={t.href}/></div><h3>{t.title}</h3><p>{t.description}</p><div class="card-meta">{t.meta}</div></a>{i === 2 && <div class="grid-ad" data-grid-ad><AdSlot type="rectangle" /></div>}{i === 11 && <div class="grid-ad" data-grid-ad><AdSlot type="rectangle" /></div>}</>)}</div><p class="catalog-empty" data-empty hidden>No matching tools. Try a broader word or choose “All”.</p></tool-catalog></Layout>
<script>
class ToolCatalog extends HTMLElement{connectedCallback(){let category='All';const input=this.querySelector('[data-search]') as HTMLInputElement;const cards=Array.from(this.querySelectorAll<HTMLElement>('[data-tool]'));const update=()=>{const q=input.value.trim().toLowerCase();let count=0;cards.forEach(c=>{c.hidden=!(c.dataset.text!.includes(q)&&(category==='All'||c.dataset.topic===category));if(!c.hidden)count++});this.querySelector('[data-count]')!.textContent=`${count} ${count===1?'result':'results'}`;this.querySelectorAll<HTMLElement>('[data-grid-ad]').forEach(ad=>ad.hidden=category!=='All'||q!=='');(this.querySelector('[data-empty]') as HTMLElement).hidden=count!==0};input.oninput=update;this.querySelectorAll<HTMLButtonElement>('button[data-category]').forEach(b=>b.onclick=()=>{category=b.dataset.category!;this.querySelectorAll<HTMLButtonElement>('button[data-category]').forEach(x=>{x.classList.toggle('selected',x===b);x.setAttribute('aria-pressed',String(x===b))});update()});}}
customElements.define('tool-catalog',ToolCatalog);
</script>
