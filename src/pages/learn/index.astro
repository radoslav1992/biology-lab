---
import DiagramThumb from '../../components/DiagramThumb.astro';
import Layout from '../../layouts/Layout.astro';
import { lessons } from '../../lib/lessons.mjs';
const paths = [
  { title: 'Start with the cell', blurb: 'Build from the smallest unit of life outward.', steps: [['/learn/cell-theory/', 'Cell theory'], ['/learn/prokaryotes-vs-eukaryotes/', 'Prokaryotes vs. eukaryotes'], ['/cells/', 'Tour the cell atlas'], ['/tools/cell-size/', 'Test why cells stay small']] },
  { title: 'Make sense of genetics', blurb: 'Follow information from a double helix to a cross.', steps: [['/learn/dna-structure/', 'DNA structure'], ['/learn/transcription-and-translation/', 'Transcription and translation'], ['/learn/mendelian-inheritance/', 'Mendelian inheritance'], ['/punnett-square-calculator/', 'Cross two parents in a Punnett square']] },
  { title: 'Explore the living world', blurb: 'From one population to a whole ecosystem.', steps: [['/learn/natural-selection/', 'Natural selection'], ['/learn/population-growth/', 'Population growth'], ['/learn/energy-flow-in-ecosystems/', 'Energy flow in ecosystems'], ['/tools/predator-prey/', 'Run a predator–prey simulation']] },
];
---
<Layout title="Biology Concept Notes — Key Ideas, Examples & Common Mistakes" section="Learn" schemaType="CollectionPage" description="Sixteen biology concept notes on cells, DNA, genetics, evolution, enzymes, and ecology, each with a key idea, a worked example, and a common mistake to avoid."><div class="intro"><div><div class="eyebrow">Concept notes</div><h1>Keep the big ideas close.</h1><p>Sixteen connected biology concepts, from cell theory to energy pyramids. Each note states the key idea in one line, works a real example with numbers, and names the mistake most people make — then hands you a tool where you can see the idea move.</p></div></div><div class="path-grid">{paths.map(p => <section class="path-card"><h3>{p.title}</h3><p>{p.blurb}</p><ol>{p.steps.map(([href, label]) => <li><a href={href}>{label}</a></li>)}</ol></section>)}</div><div class="section-heading"><div><h2>Every concept, in one place</h2><p>Read them in order for a quick course, or jump straight to the idea you are revising.</p></div></div><div class="tool-grid">{lessons.map(l => <a class="tool-card" href={`/learn/${l.slug}/`}><div class="card-top"><span class="badge">CONCEPT NOTE</span><span class="card-arrow" aria-hidden="true">↗</span></div><div class="card-diagram"><DiagramThumb kind={l.slug}/></div><h3>{l.title}</h3><p>{l.subtitle}</p><div class="card-meta">Key idea · example · common mistake</div></a>)}</div><div class="learning-strip"><div><span class="strip-label">SMALL STEPS. REAL UNDERSTANDING.</span><h2>Read a note, then test it.</h2><p>Eight quick questions on cells, genetics, molecules, ecology, or physiology, each with an explanation.</p></div><a href="/practice/">Start a practice round <span aria-hidden="true">↗</span></a></div></Layout>
