---
import AdSlot from '../../components/AdSlot.astro';
import ClassroomStrip from '../../components/ClassroomStrip.astro';
import RelatedLearning from '../../components/RelatedLearning.astro';
import Layout from '../../layouts/Layout.astro';
import { lessons } from '../../lib/lessons.mjs';
import { organelles } from '../../lib/organelles.mjs';
import { catalog } from '../../lib/catalog.mjs';
import { explorations } from '../../lib/explorations.mjs';
import { calculatorLessons } from '../../lib/related.mjs';
import { lessonNotes } from '../../lib/lesson-notes.mjs';
export function getStaticPaths() { return lessons.map(lesson => ({ params: { slug: lesson.slug }, props: { lesson } })); }
const { lesson } = Astro.props;
const suffix = ' — Key Idea & Worked Example';
const title = lesson.seoTitle || ((lesson.title + suffix).length <= 65 ? lesson.title + suffix : `${lesson.title} Explained`);
// Key terms, two check-your-understanding questions and a hand-written meta description (lesson-notes.mjs).
const notes = lessonNotes[lesson.slug];
const description = notes.description;
const index = lessons.findIndex(l => l.slug === lesson.slug);
const bySlug = Object.fromEntries(lessons.map(l => [l.slug, l]));
const related = (lesson.related || []).map(slug => bySlug[slug]).filter(l => l && l.slug !== lesson.slug);
const extra = [...lessons.slice(index + 1), ...lessons.slice(0, index)].find(l => !related.includes(l));
const relatedLessons = extra ? [...related, extra] : related;
// Everything else on the site that teaches this idea: the calculators that name this lesson and the organelle pages filed under it.
const toolHrefs = [...explorations.filter(t => t.lesson === lesson.slug).map(t => `/tools/${t.slug}/`), ...Object.keys(calculatorLessons).filter(href => calculatorLessons[href].includes(lesson.slug))];
const tools = toolHrefs.filter(href => href !== lesson.href).map(href => catalog.find(c => c.href === href)).filter(Boolean);
const cellPages = Object.entries(organelles).filter(([slug, o]) => o.lesson === lesson.slug && `/cells/${slug}/` !== lesson.href);
---
<Layout title={title} description={description} section="Learn" schemaType="Article" breadcrumbs={[['Concept notes', '/learn/'], [lesson.title, `/learn/${lesson.slug}/`]]}><article class="article"><div class="breadcrumb"><a href="/learn/">Concept notes</a> / {lesson.title}</div><div class="eyebrow">Biology Lab concept note</div><h1>{lesson.title}</h1><p>{lesson.subtitle}</p><div class="formula">{lesson.formula}</div><h2>The idea</h2><p>{lesson.body}</p><AdSlot type="rectangle" /><h2>Work through an example</h2><p>{lesson.example}</p><h2>What to watch for</h2><p>{lesson.pitfall}</p><h2>Key terms</h2><dl class="key-terms">{notes.terms.map(([term, meaning]) => <><dt>{term}</dt><dd>{meaning}</dd></>)}</dl><h2>Check your understanding</h2><div class="check-list">{notes.check.map(([question, answer]) => <details class="check-item"><summary>{question}</summary><p>{answer}</p></details>)}</div><div class="learning-strip"><div><span class="strip-label">SEE IT MOVE</span><h2>Make the idea move.</h2><p>Explore this concept with real inputs and a live diagram.</p></div><a href={lesson.href}>{lesson.cta} <span aria-hidden="true">↗</span></a></div><ClassroomStrip href={lesson.href}/><div class="related">{relatedLessons.map(l => <a href={`/learn/${l.slug}/`}>{l.title} <span aria-hidden="true">↗</span></a>)}{tools.map(t => <a href={t.href}>{t.title} <span aria-hidden="true">↗</span></a>)}{cellPages.map(([slug, o]) => <a href={`/cells/${slug}/`}>{o.title}: structure and function <span aria-hidden="true">↗</span></a>)}<a href="/learn/">All biology concept notes <span aria-hidden="true">↗</span></a><a href="/practice/">Practice this topic <span aria-hidden="true">↗</span></a></div><RelatedLearning topic={lesson.slug}/></article></Layout>
<style>
.key-terms{margin:0 0 8px;display:grid;grid-template-columns:minmax(0,200px) minmax(0,1fr);gap:10px 18px}
.key-terms dt{font-weight:700;color:var(--ink);font-size:15px;line-height:1.6}
.key-terms dd{margin:0;font-size:15px;line-height:1.6;color:var(--muted)}
.check-list{display:grid;gap:10px;margin:0 0 8px}
.check-item{border:1px solid var(--line);border-radius:12px;background:#fff;padding:14px 18px}
.check-item summary{cursor:pointer;font-weight:700;color:var(--ink);line-height:1.5}
.check-item p{margin:10px 0 0}
@media(max-width:600px){.key-terms{grid-template-columns:1fr;gap:2px}.key-terms dd{margin-bottom:10px}}
@media print{.check-item{border:0;padding:0}}
</style>
