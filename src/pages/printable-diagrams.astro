  return s;
}
// --- sheet assembly ----------------------------------------------------------
function buildSvg(kind: string, paper: string, key: boolean, nameLine: boolean) {
  const { w: W, h: H } = PAPERS[paper] || PAPERS.a4, name = PRINTABLES[kind].name;
  const subtitle = { 'animal-cell': key ? 'Answer key · the 12 structures and what each one does' : 'Write the name of each numbered structure in the table below',
    'plant-cell': key ? 'Answer key · the 12 structures and what each one does' : 'Write the name of each numbered structure in the table below',
    'monohybrid-punnett': key ? 'Answer key · two worked monohybrid crosses' : 'Fill in the parent gametes along the top and side, then complete every box',
    'dihybrid-punnett': key ? 'Answer key · 16 boxes and the 9 : 3 : 3 : 1 phenotype ratio' : 'List the four gamete types for each parent, fill the 16 boxes, then tally the phenotypes',
    'pedigree-chart': key ? 'Answer key · an autosomal recessive trait traced through three generations' : 'Shade the affected individuals, then work out the genotypes and the pattern of inheritance' }[kind];
  let body = T(10, 12, `Biology Lab · ${name}`, { size: 5, weight: 700 }) + T(10, 19.5, subtitle, { size: 3, color: MUTED });
  let top = 26;
  if (nameLine) { body += T(10, 28.5, 'Name: ______________________________        Date: ________________        Class: ____________', { size: 3, color: MUTED }); top = 34; }
  body += kind === 'monohybrid-punnett' ? monohybridSheet(key, top) : kind === 'dihybrid-punnett' ? dihybridSheet(key, top) : kind === 'pedigree-chart' ? pedigreeSheet(key, top) : cellSheet(kind, key, top, H);
  body += path(`M 10 ${H - 14} v 4 M 10 ${H - 12} h 20 M 30 ${H - 14} v 4`, { stroke: INK, width: 0.4 }) + T(36, H - 11, '20 mm scale check · print at 100%', { size: 3, color: MUTED }) + T(180, H - 11, 'thebiologylab.org · free to print for classroom use', { size: 2.6, color: MUTED, anchor: 'end' });
  return `<svg xmlns="http://www.w3.org/2000/svg" width="${W}mm" height="${H}mm" viewBox="0 0 ${W} ${H}" role="img" aria-label="${escapeHtml(name)} printable">` + rect(0, 0, W, H, { fill: '#fff', stroke: 'none', width: 0 }) + group(body, { 'font-family': "'DM Sans', Helvetica, Arial, sans-serif" }) + '</svg>';
}
type Ctrl = HTMLSelectElement | HTMLInputElement;
class PrintableLab extends HTMLElement {
  connectedCallback() {
    const select = this.querySelector('[data-printable]') as HTMLSelectElement, paper = this.querySelector('[data-paper]') as HTMLSelectElement;
    const key = this.querySelector('[data-key]') as HTMLInputElement, nameLine = this.querySelector('[data-name]') as HTMLInputElement;
    const preview = this.querySelector('[data-preview]') as HTMLElement, badge = this.querySelector('[data-badge]') as HTMLElement, caption = this.querySelector('[data-caption]') as HTMLElement, error = this.querySelector('[data-error]') as HTMLElement;
    const buttons = this.querySelectorAll<HTMLButtonElement>('[data-download],[data-print]');
    const pageStyle = document.createElement('style');
    document.head.appendChild(pageStyle);
    let svgText = '';
    const render = () => {
      try {
        const kind = select.value, size = paper.value;
        if (!PRINTABLES[kind] || !PAPERS[size]) throw new Error('Choose a printable and a paper size.');
        svgText = buildSvg(kind, size, key.checked, nameLine.checked);
        preview.innerHTML = svgText;
        badge.textContent = PAPERS[size].badge;
        caption.textContent = PRINTABLES[kind].caption + (key.checked ? ' · answer key' : '');
        error.textContent = '';
        pageStyle.textContent = `@page{size:${size === 'letter' ? 'letter' : 'A4'} portrait;margin:10mm}`;
        buttons.forEach(b => { b.disabled = false; });
      } catch (e) {
        error.textContent = (e as Error).message;
        preview.innerHTML = '<p>Choose a printable to generate the sheet.</p>';
        svgText = '';
        buttons.forEach(b => { b.disabled = true; });
      }
    };
    const params = new URLSearchParams(location.search), wanted = params.get('sheet') || '';
    if (PRINTABLES[wanted]) select.value = wanted;
    if (params.get('key') === '1') key.checked = true;
    if (params.get('paper') === 'letter') paper.value = 'letter';
    ([select, paper, key, nameLine] as Ctrl[]).forEach(el => { el.onchange = render; });
    document.querySelectorAll<HTMLAnchorElement>('[data-open-sheet]').forEach(a => {
      a.addEventListener('click', event => {
        const slug = a.dataset.openSheet || '';
        if (!PRINTABLES[slug]) return;
        event.preventDefault();
        select.value = slug;
        render();
        const q = new URLSearchParams({ sheet: slug });
        if (key.checked) q.set('key', '1');
        if (paper.value === 'letter') q.set('paper', 'letter');
        history.replaceState(null, '', '?' + q);
        this.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });
    (this.querySelector('[data-download]') as HTMLButtonElement).onclick = () => {
      if (!svgText) return;
      const url = URL.createObjectURL(new Blob(['<?xml version="1.0" encoding="UTF-8"?>\n' + svgText], { type: 'image/svg+xml' }));
      const a = document.createElement('a');
      a.href = url;
      a.download = `biology-lab-${select.value}${key.checked ? '-answer-key' : ''}.svg`;
      a.click();
      setTimeout(() => URL.revokeObjectURL(url), 1000);
    };
    (this.querySelector('[data-print]') as HTMLButtonElement).onclick = () => { if (svgText) window.print(); };
    render();
  }
}
customElements.define('printable-lab', PrintableLab);
</script>
