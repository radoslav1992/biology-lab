    s += line(a + r, y, b - r, y, { color: INK, width: 0.45 }) + line(m, y, m, sib, { color: INK, width: 0.45 }) + line(Math.min(...kids), sib, Math.max(...kids), sib, { color: INK, width: 0.45 });
    for (const k of kids) s += line(k, sib, k, rowY[gen + 1] - r, { color: INK, width: 0.45 });
  }
