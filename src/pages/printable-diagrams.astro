  const qy = top + 147;
  s += T(10, qy - 5, `Scenario: individuals II-3, II-5, III-2 and III-4 have the trait${key ? ' (shaded below).' : '. Shade their symbols, then answer the questions below.'}`, { size: 2.8, color: MUTED });
  s += T(10, qy, key ? 'Trait: autosomal recessive (worked example)' : 'Trait: ______________________________', { size: 3, weight: 700 });
  s += T(100, qy, key ? 'Pattern of inheritance: recessive, autosomal' : 'Pattern of inheritance: ______________________', { size: 3, weight: 700 });
  const prompts = key ? [
    '1. Affected: II-3, II-5, III-2 and III-4 (shaded). Every unaffected parent of an affected child must be a carrier (Aa); III-1 could be AA or Aa.',
    '2. Recessive: unaffected parents I-1 and I-2 have an affected son, II-3, so both carry a hidden allele (Aa × Aa gives each child a 1 in 4 chance of aa).',
    '3. Autosomal: affected daughter III-2 has an unaffected father (II-1), which rules out X-linked recessive; affected father II-5 has an unaffected daughter (III-3), which rules out X-linked dominant.',
  ] : [
