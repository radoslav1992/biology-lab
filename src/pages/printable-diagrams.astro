    ['II-1', 1, 40, 'M', false, 'Aa'], ['II-2', 1, 70, 'F', false, 'Aa'], ['II-3', 1, 100, 'M', true, 'aa'], ['II-4', 1, 130, 'F', false, 'Aa'], ['II-5', 1, 160, 'M', true, 'aa'],
    ['III-1', 2, 42, 'M', false, 'AA or Aa'], ['III-2', 2, 68, 'F', true, 'aa'], ['III-3', 2, 125, 'F', false, 'Aa'], ['III-4', 2, 145, 'M', true, 'aa'], ['III-5', 2, 165, 'F', false, 'Aa'],
