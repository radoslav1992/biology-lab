    s += sex === 'M' ? rect(x - 2.4, ly - 2.4, 4.8, 4.8, { fill: aff ? INK : '#fff', stroke: INK, width: 0.4 }) : circle(x, ly, 2.4, { fill: aff ? INK : '#fff', stroke: INK, width: 0.4 });
