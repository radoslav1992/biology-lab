<script>
import { escapeHtml } from '../lib/format.mjs';
import { text, line, rect, circle, ellipse, path, group } from '../lib/svg.mjs';
// Every sheet is drawn in millimetres inside a 190 × 250 (A4) or 190 × 240 (Letter) viewBox, so a 100% print is true to scale.
const INK = '#173226', MUTED = '#5b6b62', LEAFDARK = '#226b45', CORAL = '#c9582a', SKY = '#4b86b4', PLUM = '#7b4b8a', RULE = '#9aa8a0';
const PAPERS: Record<string, { w: number; h: number; badge: string }> = { a4: { w: 190, h: 250, badge: 'A4 · PORTRAIT' }, letter: { w: 190, h: 240, badge: 'LETTER · PORTRAIT' } };
const PRINTABLES: Record<string, { name: string; caption: string }> = {
  'animal-cell': { name: 'Animal cell to label', caption: '12 numbered structures · answer table below' },
  'plant-cell': { name: 'Plant cell to label', caption: '12 numbered structures · answer table below' },
  'monohybrid-punnett': { name: 'Monohybrid Punnett square grid (2 × 2)', caption: 'Two 2 × 2 grids · genotype and phenotype ratio lines' },
  'dihybrid-punnett': { name: 'Dihybrid Punnett square grid (4 × 4)', caption: '4 × 4 grid · phenotype tally table' },
  'pedigree-chart': { name: 'Blank pedigree chart (3 generations)', caption: '12 individuals · legend · analysis prompts' },
};
const f = n => Math.round(n * 100) / 100;
const T = (x, y, v, o = {}) => text(f(x), f(y), v, { color: INK, size: 3, anchor: 'start', ...o });
const rule = (x1, y, x2) => line(f(x1), f(y), f(x2), f(y), { color: RULE, width: 0.3 });
const dot = (x, y, r = 0.45, color = INK) => circle(f(x), f(y), r, { fill: color, stroke: 'none', width: 0 });
const smoothD = pts => { let d = `M ${f(pts[0][0])} ${f(pts[0][1])}`; for (let i = 1; i < pts.length - 1; i++) { const m = [(pts[i][0] + pts[i + 1][0]) / 2, (pts[i][1] + pts[i + 1][1]) / 2]; d += ` Q ${f(pts[i][0])} ${f(pts[i][1])} ${f(m[0])} ${f(m[1])}`; } const l = pts[pts.length - 1]; return d + ` L ${f(l[0])} ${f(l[1])}`; };
const wrap = (str, max) => { const lines = []; let cur = ''; for (const w of str.split(' ')) { if (cur && (cur + ' ' + w).length > max) { lines.push(cur); cur = w; } else cur = cur ? cur + ' ' + w : w; } if (cur) lines.push(cur); return lines; };
const para = (x, y, str, size, color = INK, width = 165) => wrap(str, Math.floor(width / (0.5 * size))).map((ln, i) => T(x, y + i * size * 1.35, ln, { size, color })).join('');
const wob = (a, s) => 1 + 0.035 * Math.sin(3 * a + s) + 0.02 * Math.sin(5 * a - 1.3 + s) + 0.012 * Math.sin(7 * a + 2.1);
const blobPoint = (cx, cy, rx, ry, s, deg) => { const a = deg * Math.PI / 180, k = wob(a, s); return [f(cx + rx * k * Math.cos(a)), f(cy + ry * k * Math.sin(a))]; };
function blob(cx, cy, rx, ry, s, n = 40) {
  const pts = Array.from({ length: n }, (_, i) => { const a = i / n * Math.PI * 2, k = wob(a, s); return [cx + rx * k * Math.cos(a), cy + ry * k * Math.sin(a)]; });
  const mid = (p, q) => [(p[0] + q[0]) / 2, (p[1] + q[1]) / 2];
  let d = `M ${f(mid(pts[0], pts[1])[0])} ${f(mid(pts[0], pts[1])[1])}`;
  for (let i = 1; i <= n; i++) { const p = pts[i % n], m = mid(p, pts[(i + 1) % n]); d += ` Q ${f(p[0])} ${f(p[1])} ${f(m[0])} ${f(m[1])}`; }
  return d + ' Z';
}
// --- organelle drawings -------------------------------------------------------
function mitochondrion(x, y, rx, ry, rot) {
  const irx = rx - 1.3, iry = ry - 1.1, n = Math.max(3, Math.floor(rx / 1.4));
  let s = ellipse(0, 0, rx, ry, { fill: '#fde7d9', stroke: CORAL, width: 0.4 }) + ellipse(0, 0, f(irx), f(iry), { fill: 'none', stroke: CORAL, width: 0.28 });
  for (let i = 0; i < n; i++) {
    const cx = -irx + 1.2 + i * ((2 * irx - 2.4) / (n - 1)), edge = iry * Math.sqrt(Math.max(0, 1 - (cx / irx) ** 2));
    s += i % 2 ? line(f(cx), f(edge), f(cx), f(-edge * 0.15), { color: CORAL, width: 0.3 }) : line(f(cx), f(-edge), f(cx), f(edge * 0.15), { color: CORAL, width: 0.3 });
  }
  return group(s, { transform: `translate(${f(x)} ${f(y)}) rotate(${rot})` });
}
function chloroplast(x, y, rx, ry, rot) {
  let s = ellipse(0, 0, rx, ry, { fill: '#dff0e2', stroke: LEAFDARK, width: 0.4 }) + ellipse(0, 0, f(rx - 1.2), f(ry - 1), { fill: 'none', stroke: LEAFDARK, width: 0.25 });
  [-rx * 0.5, 0, rx * 0.5].forEach((gx, i) => { const gy = i === 1 ? 0.6 : -0.6; for (let k = 0; k < 4; k++) s += line(f(gx - 1.3), f(gy - 1.05 + k * 0.7), f(gx + 1.3), f(gy - 1.05 + k * 0.7), { color: LEAFDARK, width: 0.35 }); });
  return group(s, { transform: `translate(${f(x)} ${f(y)}) rotate(${rot})` });
}
function nucleus(x, y, r, nl, chromatin) {
  let s = circle(f(x), f(y), r, { fill: '#e6f2e8', stroke: INK, width: 0.45 }) + circle(f(x), f(y), f(r - 1.1), { fill: 'none', stroke: INK, width: 0.3 });
  for (const [dx, dy] of chromatin) s += path(`M ${f(x + dx - 1.6)} ${f(y + dy)} q 0.8 -1.1 1.6 0 t 1.6 0`, { stroke: LEAFDARK, width: 0.35 });
  return s + circle(f(x + nl[0]), f(y + nl[1]), nl[2], { fill: '#8fcfa5', stroke: LEAFDARK, width: 0.35 });
}
function erArcs(nx, ny, radii, a0, a1, rough) {
  let s = '';
  radii.forEach((r, j) => {
    const steps = rough ? 18 : 14, pts = [];
    for (let i = 0; i <= steps; i++) { const a = (a0 + (a1 - a0) * i / steps) * Math.PI / 180, rr = r + (rough ? 0 : 0.9 * Math.sin(i * 2.1 + j)); pts.push([nx + rr * Math.cos(a), ny + rr * Math.sin(a)]); }
    s += path(smoothD(pts), { stroke: INK, width: 0.35 });
    if (rough) for (let i = 0; i <= steps; i += 2) s += dot(pts[i][0], pts[i][1], 0.42);
  });
  return s;
}
function golgi(x, y) {
  let s = '';
  [13, 12, 11, 9.5].forEach((w, i) => { const yy = y - 3 + i * 1.9; s += path(`M ${f(x - w / 2)} ${f(yy)} Q ${f(x)} ${f(yy - 1.6)} ${f(x + w / 2)} ${f(yy)}`, { stroke: PLUM, width: 0.55 }); });
  [[8, -4.5], [8.5, -1], [-8.2, 1.5], [7, 3.5]].forEach(([dx, dy]) => { s += circle(f(x + dx), f(y + dy), 0.8, { fill: '#f1e6f5', stroke: PLUM, width: 0.3 }); });
  return s;
}
function lysosome(x, y, r) { return circle(f(x), f(y), r, { fill: '#fff3d6', stroke: CORAL, width: 0.4 }) + [[-0.9, -0.6], [0.7, -0.9], [0.2, 0.8], [-0.8, 0.9]].map(([dx, dy]) => dot(x + dx, y + dy, 0.35, CORAL)).join(''); }
function centrioles(x, y) {
  let s = rect(f(x), f(y), 6.5, 2.2, { fill: '#fff', stroke: INK, width: 0.35, rx: 0.5 });
  for (let i = 1; i <= 3; i++) s += line(f(x + i * 1.6), f(y + 0.3), f(x + i * 1.6), f(y + 1.9), { color: INK, width: 0.25 });
  const vx = x + 8.3, vy = y - 3.6;
  s += rect(f(vx), f(vy), 2.2, 6.5, { fill: '#fff', stroke: INK, width: 0.35, rx: 0.5 });
  for (let i = 1; i <= 3; i++) s += line(f(vx + 0.3), f(vy + i * 1.6), f(vx + 1.9), f(vy + i * 1.6), { color: INK, width: 0.25 });
  return s;
}
const cluster = (x, y) => [[0, 0], [-3, -2], [3, -1.5], [-1.5, 3], [2.5, 2.5], [-4, 1], [4, -3.5]].map(([dx, dy]) => dot(x + dx, y + dy)).join('');
// --- the two cell diagrams ---------------------------------------------------
const ROLES: Record<string, [string, string]> = {
  'Cell membrane': ['Cell membrane', 'phospholipid bilayer that controls what enters and leaves the cell'],
  'Cell wall': ['Cell wall', 'rigid cellulose layer outside the membrane that supports and protects the cell'],
  'Cytoplasm': ['Cytoplasm', 'jelly-like cytosol plus organelles, where most of the cell’s reactions happen'],
  'Nucleus': ['Nucleus', 'stores the DNA (chromosomes) and controls the cell’s activities'],
  'Nucleolus': ['Nucleolus', 'dense region where ribosomal RNA is made and ribosome subunits are assembled'],
  'Nuclear envelope': ['Nuclear envelope', 'double membrane with pores that separates the nucleus from the cytoplasm'],
  'Mitochondrion': ['Mitochondrion', 'site of aerobic respiration; releases energy from glucose as ATP'],
  'Rough ER': ['Rough endoplasmic reticulum', 'ribosome-studded membranes that fold and transport proteins'],
  'Smooth ER': ['Smooth endoplasmic reticulum', 'makes lipids and steroids and detoxifies drugs; no ribosomes'],
  'Golgi apparatus': ['Golgi apparatus', 'modifies, sorts and packages proteins into vesicles for export'],
  'Ribosomes': ['Ribosomes', 'build proteins by joining amino acids in the order set by mRNA'],
  'Lysosome': ['Lysosome', 'sac of digestive enzymes that breaks down waste and worn-out organelles'],
  'Centrioles': ['Centrioles', 'paired microtubule cylinders that organize the spindle during cell division'],
  'Chloroplast': ['Chloroplast', 'site of photosynthesis; chlorophyll in the thylakoids captures light energy'],
  'Central vacuole': ['Central vacuole', 'large fluid-filled sac that stores water and keeps the cell turgid'],
};
function animalCell(cy) {
  const cx = 95, N = [83, cy - 5];
  let s = path(blob(cx, cy, 50, 52, 0.7), { fill: '#fffdf7', stroke: CORAL, width: 0.6 });
  s += erArcs(N[0], N[1], [17, 20, 23], -55, 25, true) + erArcs(N[0], N[1], [17, 20.5, 24], 40, 105, false);
  s += nucleus(N[0], N[1], 14, [4.5, 6.5, 3.8], [[3, -8], [-8, 2], [6, -1]]);
  s += mitochondrion(108, cy - 28, 8, 4, -15) + mitochondrion(81, cy + 32, 7, 3.5, -12);
  s += golgi(112, cy + 28) + lysosome(133, cy - 9, 2.8) + centrioles(60, cy + 25) + cluster(70, cy - 27);
  for (const [x, y] of [[100, -44], [92, -38], [112, -40], [124, 6], [130, 12], [100, 42], [96, 30], [56, 18], [50, -3], [78, -38], [88, 44], [112, 6], [138, 8], [76, 21], [118, 38], [66, 40]]) s += dot(x, cy + y);
  const items: Item[] = [
    { name: 'Cell membrane', side: 'L', row: 0, anchor: blobPoint(cx, cy, 50, 52, 0.7, 228) },
    { name: 'Ribosomes', side: 'L', row: 1, anchor: [66.5, cy - 26.5] },
    { name: 'Nucleus', side: 'L', row: 2, anchor: [78, cy - 13], dot: true },
    { name: 'Nuclear envelope', side: 'L', row: 3, anchor: [69.3, cy - 2.1] },
    { name: 'Nucleolus', side: 'L', row: 4, anchor: [87, cy + 2] },
    { name: 'Centrioles', side: 'L', row: 5, anchor: [63, cy + 28] },
    { name: 'Mitochondrion', side: 'R', row: 0, anchor: [115.7, cy - 30] },
    { name: 'Cytoplasm', side: 'R', row: 1, anchor: [127, cy - 19], dot: true },
    { name: 'Lysosome', side: 'R', row: 2, anchor: [135.8, cy - 9] },
    { name: 'Rough ER', side: 'R', row: 3, anchor: [105.7, cy - 9] },
    { name: 'Smooth ER', side: 'R', row: 4, anchor: [96.8, cy + 14.7] },
    { name: 'Golgi apparatus', side: 'R', row: 5, anchor: [121.5, cy + 30] },
  ];
  return { svg: s, items };
}
function plantCell(cy) {
  const N = [70, cy - 14];
  let s = rect(45, f(cy - 52), 100, 104, { fill: '#efe6cf', stroke: INK, width: 0.5, rx: 7 }) + rect(48, f(cy - 49), 94, 98, { fill: '#fffdf7', stroke: INK, width: 0.4, rx: 5 }) + rect(49.4, f(cy - 47.6), 91.2, 95.2, { fill: 'none', stroke: CORAL, width: 0.5, rx: 4.5 });
  s += path(blob(108, cy + 4, 27, 26, 1.3, 36), { fill: '#eef5fb', stroke: SKY, width: 0.45 });
  s += erArcs(N[0], N[1], [14.5, 17, 19.5], 210, 290, true);
  s += nucleus(N[0], N[1], 12, [3.5, 4, 3.2], [[-3, -7], [4, -5], [-6, 3]]);
  s += chloroplast(100, cy - 36, 9, 4.5, -10) + chloroplast(68, cy + 34, 9, 4.5, 20) + chloroplast(98, cy + 40, 9, 4, -8);
  s += mitochondrion(136, cy - 14, 7, 3.2, 85) + golgi(128, cy + 40) + cluster(136, cy + 22);
  for (const [x, y] of [[56, -44], [90, -45], [118, -44], [126, -40], [52, 42], [80, 44], [113, 44], [139, 3], [56, 12], [62, 4], [84, -37], [110, -28]]) s += dot(x, cy + y);
  const items: Item[] = [
    { name: 'Cell wall', side: 'L', row: 0, anchor: [46.5, cy - 38] },
    { name: 'Rough ER', side: 'L', row: 1, anchor: [54, cy - 25.2] },
    { name: 'Nucleus', side: 'L', row: 2, anchor: [66, cy - 16], dot: true },
    { name: 'Nuclear envelope', side: 'L', row: 3, anchor: [58.4, cy - 10.9] },
    { name: 'Nucleolus', side: 'L', row: 4, anchor: [73, cy - 10] },
    { name: 'Cell membrane', side: 'L', row: 5, anchor: [49.4, cy + 43] },
    { name: 'Cytoplasm', side: 'R', row: 0, anchor: [134, cy - 43], dot: true },
    { name: 'Chloroplast', side: 'R', row: 1, anchor: [109, cy - 37.5] },
    { name: 'Mitochondrion', side: 'R', row: 2, anchor: [139.4, cy - 9] },
    { name: 'Central vacuole', side: 'R', row: 3, anchor: [120, cy + 6], dot: true },
    { name: 'Ribosomes', side: 'R', row: 4, anchor: [139, cy + 23] },
    { name: 'Golgi apparatus', side: 'R', row: 5, anchor: [137.5, cy + 42] },
  ];
  return { svg: s, items };
}
type Item = { name: string; side: 'L' | 'R'; row: number; anchor: number[]; dot?: boolean };
function labels(items: Item[], key: boolean, cy: number) {
  let s = '';
  items.forEach((it, i) => {
    const y = cy - 43 + it.row * 17.2, lx = it.side === 'L' ? 14 : 176;
    let sx = it.side === 'L' ? lx + 3.4 : lx - 3.4;
    s += circle(lx, f(y), 3, { fill: '#fff', stroke: INK, width: 0.35 }) + text(lx, f(y + 1.1), String(i + 1), { color: INK, size: 3.2, weight: 700 });
    if (key) {
      const w = it.name.length * 0.62 * 2.6 + 2.2;
      s += text(it.side === 'L' ? lx + 4.2 : lx - 4.2, f(y + 0.95), it.name, { color: LEAFDARK, size: 2.6, anchor: it.side === 'L' ? 'start' : 'end', weight: 600 });
      sx = it.side === 'L' ? lx + 4.2 + w : lx - 4.2 - w;
    }
    s += line(f(sx), f(y), it.anchor[0], f(it.anchor[1]), { color: INK, width: 0.3 });
    if (it.dot) s += dot(it.anchor[0], it.anchor[1], 0.7);
  });
  return s;
}
function answerTable(items: Item[], key: boolean, top: number) {
  let s = T(10, top + 3.6, key ? 'Answer key' : 'Answer table · write the name of each numbered structure', { size: 3.4, weight: 700 });
  if (key) {
    items.forEach((it, i) => { const [full, role] = ROLES[it.name], y = top + 9.5 + i * 3.6; s += T(10, y, `${i + 1}.`, { size: 2.6, weight: 700 }) + T(16, y, `<tspan fill="${LEAFDARK}" style="fill:${LEAFDARK};font-weight:700">${full}</tspan> — ${role}`, { size: 2.6, color: MUTED }); });
  } else {
    items.forEach((it, i) => {
      const col = i < 6 ? 0 : 1, x = 10 + col * 88, y = top + 8 + (i % 6) * 7;
      s += circle(x + 3, f(y + 2.6), 2.6, { fill: '#fff', stroke: INK, width: 0.3 }) + text(x + 3, f(y + 3.6), String(i + 1), { color: INK, size: 2.8, weight: 700 }) + rule(x + 8, y + 5.2, x + 82);
    });
  }
  return s;
}
function cellSheet(kind, key, top, H) {
  const tableTop = H - 68, cy = f((top + tableTop - 6) / 2);
  const { svg, items } = kind === 'plant-cell' ? plantCell(cy) : animalCell(cy);
  return svg + labels(items, key, cy) + answerTable(items, key, tableTop);
}
// --- Punnett grids -----------------------------------------------------------
const combine = (g1, g2) => { let out = ''; for (let i = 0; i < g1.length; i++) out += [g1[i], g2[i]].sort().join(''); return out; };
const shade = geno => geno.length === 2 ? (geno[0] === geno[0].toUpperCase() ? '#e6f2e8' : '#fde7d9') : (geno[0] === 'A' ? (geno[2] === 'B' ? '#e6f2e8' : '#fff3d6') : (geno[2] === 'B' ? '#edf3f9' : '#fde7d9'));
function punnettGrid(gx, gy, c, g, n, topG, leftG) {
  const size = n === 2 ? 4.4 : 3.3;
  let s = text(f(gx + g + n * c / 2), f(gy - 2), 'Parent 1 gametes', { size: 2.6, color: MUTED }) + `<text transform="translate(${f(gx - 3)} ${f(gy + g + n * c / 2)}) rotate(-90)" text-anchor="middle" fill="${MUTED}" style="fill:${MUTED};font-size:2.6px">Parent 2 gametes</text>`;
  for (let j = 0; j < n; j++) { s += rect(f(gx + g + j * c), gy, c, g, { fill: '#edf4ef', stroke: INK, width: 0.35 }); if (topG) s += text(f(gx + g + j * c + c / 2), f(gy + g / 2 + size * 0.36), topG[j], { color: INK, size, weight: 700 }); }
  for (let i = 0; i < n; i++) { s += rect(gx, f(gy + g + i * c), g, c, { fill: '#edf4ef', stroke: INK, width: 0.35 }); if (leftG) s += text(f(gx + g / 2), f(gy + g + i * c + c / 2 + size * 0.36), leftG[i], { color: INK, size, weight: 700 }); }
  for (let i = 0; i < n; i++) for (let j = 0; j < n; j++) {
    const geno = topG && leftG ? combine(topG[j], leftG[i]) : '';
    s += rect(f(gx + g + j * c), f(gy + g + i * c), c, c, { fill: geno ? shade(geno) : '#fff', stroke: INK, width: 0.35 });
    if (geno) s += text(f(gx + g + j * c + c / 2), f(gy + g + i * c + c / 2 + size * 0.36), geno, { color: INK, size, weight: 600 });
  }
