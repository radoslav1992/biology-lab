}
function answerLines(ax, y0, rows, gap) {
  let s = '';
  rows.forEach(([label, ans], i) => { const y = y0 + i * gap; s += T(ax, y, label, { size: 2.8, color: MUTED }); s += ans ? T(ax, y + 6.3, ans, { size: 3.3, weight: 700, color: LEAFDARK }) : rule(ax, y + 8, 180); });
  return s;
}
function monohybridSheet(key, top) {
  const crosses = [
    { title: 'Aa × Aa (both parents heterozygous)', p1: ['A', 'a'], p2: ['A', 'a'], geno: '1 AA : 2 Aa : 1 aa', pheno: '3 dominant : 1 recessive', rec: '1 in 4 (25%)' },
    { title: 'Aa × aa (test cross)', p1: ['A', 'a'], p2: ['a', 'a'], geno: '1 Aa : 1 aa', pheno: '1 dominant : 1 recessive', rec: '1 in 2 (50%)' },
  ];
  let s = '';
  ['A', 'B'].forEach((letter, k) => {
    const y0 = top + 3 + k * 92, cr = key ? crosses[k] : null;
    s += T(10, y0 + 4, `Cross ${letter}${cr ? ' · ' + cr.title : ': ______________ × ______________'}`, { size: 3.6, weight: 700 });
    s += punnettGrid(34, y0 + 12, 30, 12, 2, cr && cr.p1, cr && cr.p2);
    s += answerLines(114, y0 + 24, [['Genotype ratio', cr && cr.geno], ['Phenotype ratio', cr && cr.pheno], ['Chance of a recessive offspring', cr && cr.rec]], 19);
  });
  return s;
}
function dihybridSheet(key, top) {
  const gam = ['AB', 'Ab', 'aB', 'ab'], y0 = top + 3, ax = 114;
  let s = T(10, y0 + 4, key ? 'Cross · AaBb × AaBb (both parents heterozygous for two independently assorting genes)' : 'Cross: ______________ × ______________', { size: 3.6, weight: 700 });
  s += punnettGrid(34, y0 + 12, 15, 12, 4, key ? gam : null, key ? gam : null);
  if (key) {
    s += T(ax, y0 + 18, 'Genotype ratio (9 genotypes)', { size: 2.8, color: MUTED });
    ['1 AABB : 2 AABb : 1 AAbb', '2 AaBB : 4 AaBb : 2 Aabb', '1 aaBB : 2 aaBb : 1 aabb'].forEach((ln, i) => { s += T(ax, y0 + 24 + i * 5, ln, { size: 3, weight: 700, color: LEAFDARK }); });
    s += answerLines(ax, y0 + 42, [['Phenotype ratio (A_B_ : A_bb : aaB_ : aabb)', '9 : 3 : 3 : 1'], ['Chance of an aabb offspring', '1 in 16 (6.25%)'], ['Chance of both dominant traits', '9 in 16 (56.25%)']], 15);
  } else {
    s += T(ax, y0 + 18, 'Genotype ratio', { size: 2.8, color: MUTED }) + rule(ax, y0 + 26, 180) + rule(ax, y0 + 33, 180);
    s += answerLines(ax, y0 + 42, [['Phenotype ratio', null], ['Chance of an aabb offspring', null], ['Chance of both dominant traits', null]], 16);
  }
  const ty = y0 + 96, cols = [10, 72, 130, 150], rows = [
    ['Dominant for both traits (A_B_)', 'AABB, AABb, AaBB, AaBb', '9', '9/16'],
    ['Dominant A, recessive b (A_bb)', 'AAbb, Aabb', '3', '3/16'],
    ['Recessive a, dominant B (aaB_)', 'aaBB, aaBb', '3', '3/16'],
    ['Recessive for both traits (aabb)', 'aabb', '1', '1/16'],
  ];
  s += rect(10, ty, 170, 7, { fill: '#edf4ef', stroke: 'none', width: 0 });
  ['Phenotype class', 'Genotypes in this class', 'Boxes', 'Fraction'].forEach((h, i) => { s += T(cols[i] + 2, ty + 4.7, h, { size: 2.8, weight: 700 }); });
  rows.forEach((r, i) => {
    const y = ty + 7 + i * 7.5;
    s += rule(10, y + 7.5, 180) + T(cols[0] + 2, y + 4.9, r[0], { size: 2.8 });
    if (key) r.slice(1).forEach((v, k) => { s += T(cols[k + 1] + 2, y + 4.9, v, { size: 2.8, weight: 700, color: LEAFDARK }); });
  });
  s += rule(10, ty + 7, 180);
  const py = ty + 46;
  s += T(10, py, 'Product rule check', { size: 3.4, weight: 700 });
  s += para(10, py + 6, 'Treat each gene as its own monohybrid cross. For Aa × Aa the chance of a dominant phenotype (A_) is 3/4 and of a recessive phenotype (aa) is 1/4; the same holds for B. Multiply the two chances to get each phenotype class without drawing the 16 boxes.', 2.6, MUTED);
  [['P(A_B_) = P(A_) × P(B_) =', '3/4 × 3/4 = 9/16'], ['P(A_bb) = P(A_) × P(bb) =', '3/4 × 1/4 = 3/16'], ['P(aaB_) = P(aa) × P(B_) =', '1/4 × 3/4 = 3/16'], ['P(aabb) = P(aa) × P(bb) =', '1/4 × 1/4 = 1/16']].forEach(([lhs, ans], i) => {
    const y = py + 19 + i * 7.5;
    s += T(12, y, lhs, { size: 3 });
    s += key ? T(64, y, ans, { size: 3, weight: 700, color: LEAFDARK }) : rule(64, y + 1, 120);
  });
  return s;
}
// --- pedigree ----------------------------------------------------------------
function pedigreeSheet(key, top) {
  const rowY = [top + 22, top + 60, top + 98], r = 5;
