    const y = rowY[gen], fill = key && affected ? INK : '#fff';
    s += sex === 'M' ? rect(x - r, y - r, 2 * r, 2 * r, { fill, stroke: INK, width: 0.5 }) : circle(x, y, r, { fill, stroke: INK, width: 0.5 });
    s += text(x, y + r + 4, id, { color: MUTED, size: 2.8 });
