---
import AdSlot from '../components/AdSlot.astro';
import ClassroomStrip from '../components/ClassroomStrip.astro';
import Exploration from '../components/Exploration.astro';
import Faq from '../components/Faq.astro';
import WorkedExamples from '../components/WorkedExamples.astro';
import { faqs } from '../lib/faqs.mjs';
import { findExploration, prefillHref } from '../lib/explorations.mjs';
import { timeToReach, afterDoublings, doublingTimes, doublingTime, compoundGrowth, growthRateFromCounts } from '../lib/population.mjs';
import { fmt } from '../lib/format.mjs';
import Layout from '../layouts/Layout.astro';
import PopulationGrowth from '../components/PopulationGrowth.astro';
const solver = findExploration('population-word-problems');
const comparison = [
  ['Equation', 'dN/dt = rN, so N(t) = N₀e^(rt)', 'dN/dt = rN(1 − N/K), so N(t) = K / (1 + ((K − N₀)/N₀)e^(−rt))'],
  ['Curve shape', 'J-shaped: steeper and steeper', 'S-shaped (sigmoid): levels off at K'],
  ['Key assumption', 'Unlimited resources, no crowding', 'Resources are finite, so per-capita growth falls as N rises'],
  ['Growth rate dN/dt', 'Keeps rising with N', 'Largest at N = K/2 (equal to rK/4), zero at N = K'],
  ['Doubling time', 'Constant: ln 2 / r', 'Only while N is far below K; doublings take longer near K'],
  ['Typical examples', 'Bacteria in fresh broth, a species newly introduced to an island, the human population in the 20th century', 'Yeast in a flask, sheep in Tasmania, most lab cultures once the log phase ends'],
];
const doublings = [[0.5, 139], [1, 69], [1.1, 63], [2, 35], [3, 23], [7, 10]];
// Every answer below is computed with the same functions the calculators use, so the text cannot drift from the tools.
const years = t => `${fmt(t, 2)} years`;
// Each example opens in the solver with its numbers filled in ("#try=<mode>&…" on this page).
const open = (mode, values) => ({ href: prefillHref('', mode, values), label: 'Open this problem in the solver' });
const town = timeToReach(20000, 210000, 0.12), townContinuous = timeToReach(20000, 210000, 0.12, { continuous: true }), small = timeToReach(2000, 2700, 0.025), village = timeToReach(4000, 4500, 0.02), tenth = timeToReach(3000, 4600, 0.025);
const sixty = afterDoublings(1100, 60, 180), city = afterDoublings(67900, 21, 84), world = doublingTimes(0.013);
const after7 = compoundGrowth(16000, 0.03, 7), after11 = compoundGrowth(15000, 0.025, 11), after14 = compoundGrowth(8000, 0.045, 14);
const census = growthRateFromCounts(179323175, 331449281, 60);
const compound = [
  { question: 'A town has a population of 16,000 and grows at 3% every year. What will be the population after 7 years, to the nearest whole number?', steps: ['Growing by 3% a year multiplies the population by 1.03 each year: N = N₀(1 + r)^t = 16,000 × 1.03^7.', `1.03^7 = ${fmt(1.03 ** 7, 6)}, so N = 16,000 × ${fmt(1.03 ** 7, 6)} = ${fmt(after7, 2)}.`], answer: `${fmt(after7, 0)} people.`, ...open('future', { n0: 16000, rate: 3, t: 7 }) },
  { question: 'A town has a population of 15,000 and grows at 2.5% every year. What will be the population after 11 years, to the nearest whole number?', steps: ['N = N₀(1 + r)^t = 15,000 × 1.025^11.', `1.025^11 = ${fmt(1.025 ** 11, 6)}, so N = 15,000 × ${fmt(1.025 ** 11, 6)} = ${fmt(after11, 2)}.`], answer: `${fmt(after11, 0)} people.`, ...open('future', { n0: 15000, rate: 2.5, t: 11 }) },
  { question: 'A town has a population of 8,000 and grows at 4.5% every year. What will be the population after 14 years, to the nearest whole number?', steps: ['N = N₀(1 + r)^t = 8,000 × 1.045^14.', `1.045^14 = ${fmt(1.045 ** 14, 6)}, so N = 8,000 × ${fmt(1.045 ** 14, 6)} = ${fmt(after14, 2)}.`], answer: `${fmt(after14, 0)} people.`, ...open('future', { n0: 8000, rate: 4.5, t: 14 }) },
];
const doublingProblems = [
  { question: 'A town doubles its size every 60 years. If the population is currently 1,100, what will the population be in 180 years?', steps: [`180 years ÷ 60 years = ${fmt(sixty.doublings)} doublings.`, 'N = N₀ × 2ⁿ = 1,100 × 2³ = 1,100 × 8.'], answer: `${fmt(sixty.N, 0)} people.`, ...open('doublings', { n0: 1100, td: 60, t: 180 }) },
  { question: 'A city’s population is currently 67,900. If the population doubles every 21 years, what will the population be 84 years from now?', steps: [`84 ÷ 21 = ${fmt(city.doublings)} doublings.`, 'N = N₀ × 2ⁿ = 67,900 × 2⁴ = 67,900 × 16.'], answer: `${fmt(city.N, 0)} people.`, ...open('doublings', { n0: 67900, td: 21, t: 84 }) },
  { question: 'By the year 2000 the global population was 6.17 billion, with r equal to 0.013. At that point, what was the population’s doubling time in years?', steps: [`r is a continuous rate, so T₂ = ln 2 ÷ r = 0.6931 ÷ 0.013 = ${years(world.continuous)}.`, `The rule of 70 gives 70 ÷ 1.3 = ${years(world.ruleOf70)}; compounding 1.3% once a year gives ${years(world.exact)}.`], answer: `about ${fmt(world.continuous, 0)} years.`, ...open('doubling', { n0: 6170000000, rate: 1.3 }) },
  { question: 'A country has a crude birth rate of 30 per 1,000 and a crude death rate of 10 per 1,000. How long will its population take to double?', steps: ['Rate of natural increase = (30 − 10) ÷ 1,000 = 0.02, or 2% per year.', `Doubling time ≈ 70 ÷ 2 = 35 years; exactly, ln 2 ÷ 0.02 = ${years(doublingTime(0.02))}.`], answer: 'about 35 years.', ...open('doubling', { rate: 2 }) },
];
const reach = [
  { question: 'A town has a population of 2,000 and grows at 2.5% every year. To the nearest year, how long will it be until the population reaches 2,700?', steps: ['2,700 = 2,000 × 1.025^t, so 1.025^t = 2,700 ÷ 2,000 = 1.35.', `t = ln 1.35 ÷ ln 1.025 = 0.3001 ÷ 0.02469 = ${years(small)}.`], answer: `about ${Math.round(small)} years.`, ...open('time', { n0: 2000, n: 2700, rate: 2.5 }) },
  { question: 'The population of a town of 20,000 is growing by 12% per year. How long will it take the population to grow to 210,000? Round to the nearest year.', steps: ['210,000 = 20,000 × 1.12^t, so 1.12^t = 10.5.', `Take logs: t = ln 10.5 ÷ ln 1.12 = 2.3514 ÷ 0.11333 = ${years(town)}.`], answer: `about ${Math.round(town)} years.`, ...open('time', { n0: 20000, n: 210000, rate: 12 }) },
  { question: 'A town has a population of 4,000 and grows at 2% every year. To the nearest year, how long will it be until the population reaches 4,500?', steps: ['1.02^t = 4,500 ÷ 4,000 = 1.125.', `t = ln 1.125 ÷ ln 1.02 = 0.1178 ÷ 0.01980 = ${years(village)}.`], answer: `about ${Math.round(village)} years.`, ...open('time', { n0: 4000, n: 4500, rate: 2 }) },
  { question: 'A town has a population of 3,000 and grows at 2.5% every year. To the nearest tenth of a year, how long will it be until the population reaches 4,600?', steps: ['1.025^t = 4,600 ÷ 3,000 = 1.5333.', `t = ln 1.5333 ÷ ln 1.025 = 0.4274 ÷ 0.02469 = ${years(tenth)}.`], answer: `${fmt(tenth, 1)} years.`, ...open('time', { n0: 3000, n: 4600, rate: 2.5 }) },
];
const rates = [
  { question: 'A population of 500 deer has 120 births and 70 deaths in one year. What is its per capita growth rate?', steps: ['Per capita growth rate r = (births − deaths) ÷ N = (120 − 70) ÷ 500.', 'r = 50 ÷ 500 = 0.1 per individual per year.'], answer: '0.1 per year, a 10% annual increase (next year about 550 deer).' },
  { question: 'The United States census counted 179,323,175 people in 1960 and 331,449,281 in 2020. What was the average annual growth rate?', steps: [`Growth factor = 331,449,281 ÷ 179,323,175 = ${fmt(331449281 / 179323175, 4)} over 60 years.`, `(1 + r)^60 = ${fmt(331449281 / 179323175, 4)}, so 1 + r = ${fmt(331449281 / 179323175, 4)}^(1/60) = ${fmt(1 + census.percent, 5)}.`], answer: `about ${fmt(census.percent * 100, 2)}% per year (a continuous rate r of ${fmt(census.r, 4)}).`, ...open('rate', { n0: 179323175, n: 331449281, t: 60 }) },
];
---
<Layout title="Population Growth Calculator: Solve Growth & Doubling Problems" section="Population growth" breadcrumbs={[['Tools', '/tools/'], ['Population growth calculator', '/population-growth-calculator/']]} description="Solve population growth word problems step by step: the population after t years at a % rate, the years to reach a target, and doubling-time problems.">
<div class="intro"><div><div class="eyebrow">Ecology and algebra, one step at a time</div><h1>Population growth calculator: solve growth and doubling-time problems step by step</h1><p>Type in a word problem such as “a town has a population of 2,000 and grows at 2.5% every year: how long until it reaches 2,700?” or “a city doubles its size every 21 years” and get the answer with every step. The solver finds the population after t years with N = N₀(1 + r)^t, the years needed to reach a target with t = ln(N ÷ N₀) ÷ ln(1 + r), the doubling time, and the growth rate between two counts. Further down, a second calculator draws exponential and logistic growth curves. It is for algebra, biology and environmental science students, and for teachers who want checked answers.</p></div></div>
<nav class="related page-jump" aria-label="On this page"><a href="#word-problems">Word-problem solver ↓</a><a href="#worked-examples">Growth after t years ↓</a><a href="#doubling-problems">Doubling-time problems ↓</a><a href="#time-to-reach">How long until it reaches… ↓</a><a href="#growth-curve">Exponential &amp; logistic curves ↓</a><a href="#growth-models-heading">Formulas ↓</a></nav>
<section id="word-problems" aria-labelledby="word-problems-heading">
<div class="section-heading"><div><div class="eyebrow">Solve for population, time, doubling or rate</div><h2 id="word-problems-heading">Population growth word-problem solver</h2><p>Pick the question your problem asks: how long until the population reaches a number, what it will be after t years, how long it takes to double, what it will be if it doubles every so many years, or what growth rate turns one count into another. Percentages compound once a year; the continuous-rate answer is shown alongside.</p></div></div>
{solver && <Exploration tool={solver}/>}
</section>
<AdSlot type="rectangle" />
<WorkedExamples items={compound} title="Compound growth problems: the population after t years" formula="N = N₀(1 + r)^t" intro="A population that grows by a fixed percentage every year is multiplied by 1 + r each year, with r written as a decimal (3% is 0.03). Raise that to the number of years and multiply by the starting population."/>
<WorkedExamples id="doubling-problems" items={doublingProblems} title="Doubling-time problems" formula="N = N₀ × 2^(t ÷ T₂)   ·   T₂ = ln 2 ÷ ln(1 + r) ≈ 70 ÷ (rate in %)" intro="If a problem tells you how often the population doubles, count the doublings and multiply by 2 that many times. If it asks how long doubling takes, divide ln 2 by the growth rate, or use the rule of 70 for a quick estimate."/>
<WorkedExamples id="time-to-reach" items={reach} title="How long until the population reaches a target?" formula="t = ln(N ÷ N₀) ÷ ln(1 + r)" intro="Divide the target by the starting population, then use logarithms to bring the exponent t down. Round only at the end, to the nearest year or tenth of a year as the question asks."/>
<WorkedExamples id="growth-rate-problems" items={rates} title="Finding the growth rate" formula="r = (births − deaths) ÷ N   ·   1 + r = (N ÷ N₀)^(1/t)" intro="Work out a per capita rate from births and deaths in one year, or an average yearly rate from two counts taken t years apart."/>
<section id="growth-curve" aria-labelledby="growth-curve-heading">
<div class="section-heading"><div><div class="eyebrow">Ecology models</div><h2 id="growth-curve-heading">Exponential and logistic growth curve calculator</h2><p>Enter a starting population N₀, a per capita growth rate r and, for logistic growth, a carrying capacity K. The calculator draws the J-shaped or S-shaped curve and gives the population at any time t with N = N₀e^(rt) or the logistic equation.</p></div></div>
<PopulationGrowth/>
</section>
<ClassroomStrip/>
<AdSlot type="rectangle" />
<section class="explanation" aria-labelledby="growth-models-heading">
  <h2 id="growth-models-heading">Exponential vs logistic growth at a glance</h2>
  <p>Both models start from the same idea: the change in population size, dN/dt, depends on how many individuals are already there. Exponential growth keeps the per-capita rate r fixed no matter how crowded things get, which is only realistic while food, space and mates are plentiful. Logistic growth multiplies r by the “room left” factor (1 − N/K), so growth fades as the population nears the carrying capacity K. Switch between the two tabs above with the same numbers to see how much difference that single factor makes.</p>
  <div class="fact-table-wrap"><table class="fact-table"><thead><tr><th scope="col">Feature</th><th scope="col">Exponential growth</th><th scope="col">Logistic growth</th></tr></thead><tbody>{comparison.map(([feature, exp, log]) => <tr><td>{feature}</td><td>{exp}</td><td>{log}</td></tr>)}</tbody></table></div>
  <h3>Percent per year or continuous rate? Two formulas, two answers</h3>
  <p>A population that “grows by 12% per year” is multiplied by 1.12 once a year: N = N₀(1 + r)^t, the same compound-interest formula banks use. Solve it for time with logs, t = ln(N/N₀) ÷ ln(1 + r). Ecology textbooks also write growth as a continuous per-capita rate, N = N₀e^(rt), which compounds every instant; then t = ln(N/N₀) ÷ r. The same r gives a slightly faster rise in the continuous model, so 20,000 people reach 210,000 in {fmt(town, 2)} years at 12% compounded yearly but in {fmt(townContinuous, 2)} years at a continuous r = 0.12. If a question uses e or calls r the intrinsic or per-capita rate, use the continuous formula; if it says “percent per year,” use the compound one.</p>
  <h3>Reading r, the per-capita growth rate</h3>
  <p>r is the birth rate minus the death rate per individual per unit of time, written as a decimal. A value of 0.1 per hour means each individual adds, on average, 0.1 new individuals every hour. Because growth compounds continuously, the population multiplies by e^0.1 ≈ 1.105 each hour, a 10.5% rise rather than exactly 10%. A negative r describes a shrinking population, and r = 0 means births and deaths balance. Keep r and t in the same time unit: a rate per day paired with a time in hours gives nonsense.</p>
  <h3>Doubling time and the rule of 70</h3>
  <p>For exponential growth the doubling time is T₂ = ln 2 / r ≈ 0.693 / r. If you know the growth rate as a percentage, divide 69.3 by it (usually rounded to the “rule of 70”): a population growing at 1.1% per year doubles in about 63 years, and one growing at 2% doubles in about 35. The world population grew fastest, at roughly 2.1% per year, in the late 1960s, a pace that doubles a population every 33 years; the rate has since fallen below 1%.</p>
  <div class="fact-table-wrap"><table class="fact-table"><thead><tr><th scope="col">Growth rate per year</th><th scope="col">Doubling time (ln 2 / r)</th></tr></thead><tbody>{doublings.map(([rate, years]) => <tr><td>{rate}%</td><td>about {years} years</td></tr>)}</tbody></table></div>
  <h3>Carrying capacity in the real world</h3>
  <p>K is set by whatever runs out first: food, nesting sites, water, or the reach of predators and disease. Sheep introduced to Tasmania in the early 1800s followed a textbook S-curve, leveling off near 1.7 million by the 1850s. Populations can also overshoot: 25 reindeer released on St. Paul Island, Alaska, in 1911 grew to about 2,000 by 1938, stripped the lichen they depended on, and crashed to 8 animals by 1950. K is not a fixed number either; it moves with the seasons, rainfall and the arrival of competitors, which is why real curves wobble around the smooth line this calculator draws.</p>
</section>
<div class="related"><a href="/learn/population-growth/">Exponential vs logistic growth explained ↗</a><a href="/tools/predator-prey/">Predator–prey cycles (Lotka–Volterra) ↗</a><a href="/tools/bacterial-growth/">Bacterial growth &amp; doubling time ↗</a><a href="/practice/">Practice ecology questions ↗</a></div>
<Faq items={faqs['population-growth-calculator']} title="Population growth questions"/>
</Layout>
