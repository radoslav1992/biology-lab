---
import BiologySpecimen from '../components/BiologySpecimen.astro';
import LearningApps from '../components/LearningApps.astro';
import Faq from '../components/Faq.astro';
import { faqs } from '../lib/faqs.mjs';
import Layout from '../layouts/Layout.astro';
import PunnettSquare from '../components/PunnettSquare.astro';
import ToolCards from '../components/ToolCards.astro';
import { catalog } from '../lib/catalog.mjs';
import { lessons } from '../lib/lessons.mjs';
import { QUESTIONS } from '../lib/practice.mjs';
import { organelles } from '../lib/organelles.mjs';
const toolCount = catalog.filter(t => !['Practice', 'Reference'].includes(t.category) && t.href !== '/cells/').length;
---
<Layout title="Free Biology Calculators & Interactive Explorers" description="Free biology tools: build Punnett squares, translate DNA into protein, model population growth, test Hardy-Weinberg equilibrium, and practice with explanations.">
<section class="home-stage" aria-labelledby="home-title">
  <div class="home-intro">
    <div class="eyebrow">The science of living things</div>
    <h1 id="home-title">Life, under<br/>the <em>lens.</em></h1>
    <p>From a single cell to a whole ecosystem. Explore the patterns of life with free biology calculators and interactive experiments.</p>
    <a class="primary-link" href="/tools/">Explore the lab <span aria-hidden="true">↗</span></a>
    <span class="free-note">Free to explore. No account needed.</span>
    <BiologySpecimen/>
  </div>
  <div class="home-experiment">
    <div class="experiment-heading"><span class="experiment-number">01 / GENETICS</span><span>Change a parent. Discover a pattern.</span></div>
    <PunnettSquare compact/>
    <a class="experiment-link" href="/punnett-square-calculator/">Explore the full Punnett square calculator <span aria-hidden="true">↗</span></a>
  </div>
</section>
<div class="stat-strip"><span><strong>{toolCount}</strong>interactive tools</span><span><strong>{Object.keys(organelles).length}</strong>organelles to explore</span><span><strong>{lessons.length}</strong>ideas explained</span><span><strong>{QUESTIONS.length}</strong>ways to practice</span></div>
<div class="section-heading"><div><div class="eyebrow">Your field guide to biology</div><h2>Interactive biology tools.<br/>A bigger picture of life.</h2><p>Explore cells, decode DNA, and test the patterns that connect living things.</p></div><a class="text-link" href="/tools/">All tools & collections ↗</a></div><ToolCards/>
<div class="learning-strip"><div><span class="strip-label">OBSERVE. QUESTION. UNDERSTAND.</span><h2>Let your understanding grow.</h2><p>Eight biology questions, with explanations to help each idea take root.</p></div><a href="/practice/">Start a practice round ↗</a></div>
<LearningApps/><Faq items={faqs['home']} title="Biology Lab: frequently asked questions"/></Layout>
