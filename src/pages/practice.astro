---
import Layout from '../layouts/Layout.astro';import {QUESTIONS} from '../lib/practice.mjs';
const topics=[['mixed','Mixed'],['cells','Cells'],['genetics','Genetics'],['molecular','Molecular'],['ecology','Ecology'],['physiology','Physiology']];
---
<Layout title="Biology Practice Questions — 100 Quiz Questions & Explanations" section="Practice" description="Free biology quiz: eight-question rounds on cells, genetics, molecular biology, ecology, and human physiology, each with explanations and mistake review."><div class="intro"><div><div class="eyebrow">Practice, understand, try again</div><h1>Turn “I think” into “I know.”</h1><p>{QUESTIONS.length} questions across five topics: cells, genetics, molecular biology, ecology, and human physiology. No timer. An explanation after every answer.</p></div><a class="text-link" href="/worksheets/">Prefer paper? Create a worksheet ↗</a></div><practice-lab><div class="tabs" aria-label="Practice topic">{topics.map(([value,label],i)=><button class:list={['tab',{active:i===0}]} data-topic={value} aria-pressed={i===0}>{label}</button>)}</div><div class="question-card"><div class="question-top"><span data-count></span><span data-score></span></div><div class="progress" role="progressbar" aria-label="Questions answered" aria-valuemin="0" aria-valuemax="8" aria-valuenow="0"><div data-progress style="width:0"></div></div><div data-body></div><div class="feedback" data-feedback aria-live="polite"></div><button class="primary" data-next hidden>Next question →</button><p class="small-note" data-best></p></div></practice-lab><noscript>Enable JavaScript to answer questions, or read the concept notes and the cell atlas without JavaScript.</noscript><div class="related"><a href="/learn/">Browse the concept notes ↗</a><a href="/tools/">Explore a tool ↗</a></div></Layout>
<script>
import {makeRound,shuffle} from '../lib/practice.mjs';
class PracticeLab extends HTMLElement {
 connectedCallback(){let topic='mixed',round=makeRound(topic),index=0,score=0,answered=false,reviewMode=false;let misses:any[]=[];const next=this.querySelector('[data-next]') as HTMLButtonElement;const body=this.querySelector('[data-body]')!;const feedback=this.querySelector('[data-feedback]')!;
 const best=()=>{try{const saved=localStorage.getItem('biology-lab-best-'+topic);this.querySelector('[data-best]')!.textContent=saved?`Best full round on this device: ${saved}/8. Scores stay in this browser.`:'Your best full-round score is saved only in this browser.';}catch{this.querySelector('[data-best]')!.textContent='Browser storage is unavailable; this round still works.'}};
 const updateProgress=()=>{const count=index+(answered?1:0);(this.querySelector('[data-progress]') as HTMLElement).style.width=`${count/round.length*100}%`;this.querySelector('[role=progressbar]')!.setAttribute('aria-valuenow',String(count));this.querySelector('[role=progressbar]')!.setAttribute('aria-valuemax',String(round.length));this.querySelector('[data-score]')!.textContent=`${score} correct`};
 const show=()=>{answered=false;next.hidden=true;feedback.textContent='';feedback.className='feedback';this.querySelector('[data-count]')!.textContent=`${reviewMode?'Focused retry · ':''}Question ${index+1} of ${round.length}`;const q=round[index];body.innerHTML=`<span class="badge">${q.topic.toUpperCase()}</span><h2 class="question" tabindex="-1">${q.q}</h2><div class="answer-options">${q.choices.map((c:any,i:number)=>`<button data-answer="${i}"><span class="answer-letter" aria-hidden="true">${String.fromCharCode(65+i)}</span><span>${c.text}</span></button>`).join('')}</div>`;body.querySelectorAll<HTMLButtonElement>('[data-answer]').forEach(b=>b.onclick=()=>{if(answered)return;answered=true;const n=Number(b.dataset.answer);if(q.choices[n].correct)score++;else misses.push({...q,chosen:q.choices[n].text});body.querySelectorAll<HTMLButtonElement>('[data-answer]').forEach((button,i)=>{button.disabled=true;if(q.choices[i].correct)button.classList.add('correct');else if(i===n)button.classList.add('incorrect')});feedback.className='feedback '+(q.choices[n].correct?'feedback-correct':'feedback-retry');feedback.textContent=(q.choices[n].correct?'That’s right. ':'Not quite. ')+q.why;next.hidden=false;next.textContent=index===round.length-1?'See your result →':'Next question →';updateProgress()});updateProgress();best()};
 const reset=()=>{round=makeRound(topic);index=0;score=0;misses=[];reviewMode=false;show()};
 const finish=()=>{if(!reviewMode){try{const key='biology-lab-best-'+topic;localStorage.setItem(key,String(Math.max(Number(localStorage.getItem(key)||0),score)))}catch{}}this.querySelector('[data-count]')!.textContent='Round complete';body.innerHTML=`<div class="score-orbit" style="--score-angle:${score/round.length*360}deg"><span><strong>${score}<small> / ${round.length}</small></strong><span>correct answers</span></span></div><span class="badge">${reviewMode?'RETRY':'PRACTICE'} COMPLETE</span><h2 class="question" tabindex="-1">${score} out of ${round.length}. ${score===round.length?'Beautifully done.':'Every answer is a place to start.'}</h2><div class="pills"><button class="primary" data-again>Start a new round</button>${misses.length?'<button class="secondary" data-retry>Retry missed questions</button>':''}</div>${misses.length?`<h3 style="margin-top:30px">Review your mistakes</h3>${misses.map(q=>`<div class="review-item"><strong>${q.q}</strong><p>Your answer: ${q.chosen}<br/>Correct answer: ${q.choices.find((c:any)=>c.correct).text}</p><p>${q.why}</p></div>`).join('')}`:'<p>You answered every question correctly. Try a different topic or generate a worksheet.</p>'}`;feedback.textContent='';next.hidden=true;best();(body.querySelector('[data-again]') as HTMLButtonElement).onclick=reset;const retry=body.querySelector('[data-retry]') as HTMLButtonElement;if(retry)retry.onclick=()=>{round=misses.map(q=>({...q,choices:shuffle(q.choices)}));misses=[];index=0;score=0;reviewMode=true;show();(body.querySelector('.question') as HTMLElement).focus()};(body.querySelector('.question') as HTMLElement).focus();};
 next.onclick=()=>{if(index===round.length-1)finish();else{index++;show();(body.querySelector('.question') as HTMLElement).focus()}};
 this.querySelectorAll<HTMLButtonElement>('[data-topic]').forEach(b=>b.onclick=()=>{topic=b.dataset.topic!;this.querySelectorAll<HTMLButtonElement>('[data-topic]').forEach(x=>{x.classList.toggle('active',x===b);x.setAttribute('aria-pressed',String(x===b))});reset()});show();
 }
}
customElements.define('practice-lab',PracticeLab);
</script>
