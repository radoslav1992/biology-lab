---
import Layout from '../../../layouts/Layout.astro';
import ActivityTable from '../../../components/ActivityTable.astro';
import { activities, standards } from '../../../lib/activities.mjs';
// Teacher answer keys: noindex, no ads, left out of the sitemap (astro.config.mjs) and linked only from /teachers/.
export function getStaticPaths() { return activities.map(act => ({ params: { slug: act.id }, props: { act } })); }
const { act } = Astro.props;
---
<Layout title={`Answer Key: ${act.title}`} description={`Teacher answer key for the ${act.title}: the completed results table and worked answers, calculated with the same code as the tool.`} section="Teachers" schemaType="Article" ads={false} noindex breadcrumbs={[['For teachers', '/teachers/'], [`Answer key: ${act.title}`, `/teachers/answers/${act.id}/`]]}><article class="activity-sheet answer-key"><div class="breadcrumb"><a href="/teachers/">For teachers</a> / Answer key</div><header class="activity-head"><div><div class="eyebrow">Teacher answer key · {act.grade} · about {act.minutes} minutes</div><h1>Answer key: {act.title}</h1></div></header><p class="key-note no-print">For teachers. This page is hidden from search engines and not linked from student pages, but it is not password-protected, so please don’t share the link with students. Student activity: <a href={act.path}>{act.title}</a>.</p><p class="activity-goal"><strong>Goal:</strong> {act.goal}</p>{act.standards.length > 0 && <p class="activity-meta">Connects to NGSS {act.standards.map(code => `${code} (${standards[code]})`).join('; ')}</p>}<h2>Completed results table</h2><p class="activity-meta">Every value is the tool’s own readout for that setting, calculated with the same code as the <a class="text-link" href={act.tool.href}>{act.tool.name}</a>.</p><ActivityTable act={act} answers/><h2>Answers</h2><ol class="activity-questions key-answers">{act.questions.map(q => <li><p class="key-question">{q.q}</p><p>{q.a}</p></li>)}</ol><div class="activity-actions no-print"><button class="primary" type="button" data-print>Print answer key</button><a class="secondary" href="/teachers/">All activities</a></div></article></Layout>
<script>document.querySelector('[data-print]')?.addEventListener('click', () => print());</script>
