---
// Line-art thumbnail for tool cards, atlas cards, and concept-note cards (240 × 136 viewBox, renders at ~115–150px tall).
// `kind` is a route ('/tools/enzyme-kinetics/'), an organelle slug ('mitochondrion'), or a lesson slug ('photosynthesis').
// Specific patterns are tested before general ones, so 'chloroplast' wins over the generic cell and 'golgi' wins over the two-cell osmosis drawing.
const { kind = 'cell', class: className = '' } = Astro.props;
const key = String(kind).toLowerCase();
const punnett = /punnett|mendelian/.test(key);
const hardy = /hardy|allele/.test(key);
const nucleus = /nucleus/.test(key);
const helix = /dna/.test(key);
const growth = /population-growth|logistic/.test(key);
const cube = /cell-size|surface-area/.test(key);
const enzyme = /enzyme|kinetics|lysosome/.test(key);
const beaker = /dilution/.test(key);
const microscope = /magnification|lab-measurement|microscop/.test(key);
const golgi = /golgi/.test(key);
const twoCells = /water-potential|osmosis|cell-transport|cell-membrane/.test(key);
const bacteria = /bacteria|prokaryote/.test(key);
const pyramid = /energy-pyramid|energy-flow|trophic/.test(key);
const bars = /chi-square/.test(key);
const waves = /predator|lotka/.test(key);
const mito = /mitochondri|cellular-respiration/.test(key);
const chloro = /chloroplast|photosynthesis/.test(key);
const ribosome = /ribosome|transcription-and-translation/.test(key);
const mitosis = /mitosis|meiosis/.test(key);
const er = /endoplasmic|reticulum/.test(key);
const tree = /natural-selection|evolution/.test(key);
const printable = /printable/.test(key);
const paper = /worksheet|practice|learn|quiz/.test(key);
