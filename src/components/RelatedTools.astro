---
// "Related tools" on a calculator page: its sibling tools from related.mjs, each with the reason to open it.
import { catalog } from '../lib/catalog.mjs';
import { relatedTools } from '../lib/related.mjs';
const { href = Astro.url.pathname } = Astro.props;
const items = (relatedTools[href] || []).map(([target, why]) => ({ target, why, title: catalog.find(t => t.href === target)?.title })).filter(i => i.title);
---
{items.length > 0 && <section class="related-tools" aria-labelledby="related-tools-heading"><h2 id="related-tools-heading">Related tools</h2><ul>{items.map(i => <li><a class="text-link" href={i.target}>{i.title}</a>: {i.why}</li>)}</ul></section>}
<style>
.related-tools{margin:28px 0 0}
.related-tools h2{font-size:20px;margin:0 5px 8px}
.related-tools ul{padding-left:22px;margin:0;display:grid;gap:6px}
.related-tools li{font-size:15px;line-height:1.65;color:var(--muted)}
.related-tools a{font-weight:600}
</style>
