---
// Cell atlas diagram: a labeled animal or plant cell whose organelles link to their atlas pages.
// Props: highlight (organelle slug), kind ('animal' | 'plant'), interactive (adds the animal/plant toggle and pre-renders both cells),
// poster (renders only the bare drawings, one wrapper per cell, for a page that frames them itself: the 3D cell's poster and fallback).
// The SVG is drawn at build time by src/lib/cell-diagram.mjs (shared with the label-the-cell quiz); only the toggle and the key-to-diagram hover need JavaScript.
import { organelles, cellTypes } from '../lib/organelles.mjs';
import { drawCell } from '../lib/cell-diagram.mjs';
const { highlight, kind = 'animal', interactive = false, poster = false } = Astro.props;
const HIGHLIGHT = highlight && organelles[highlight] ? highlight : undefined;
const KIND = cellTypes[kind] ? kind : 'animal';

const views = (interactive ? ['animal', 'plant'] : [KIND]).map(k => ({ kind: k, ...cellTypes[k], ...drawCell(k, { highlight: HIGHLIGHT }) }));
const current = cellTypes[KIND];
const spotlight = HIGHLIGHT ? organelles[HIGHLIGHT] : null;
const svgLabel = v => `Labeled diagram of ${v.title.toLowerCase()} with numbered organelles${spotlight ? `, highlighting the ${spotlight.title.toLowerCase()}` : ''}`;
---
{poster && views.map(v => <div class="cell-poster" data-cell={v.kind} hidden={v.kind !== KIND}><svg viewBox="0 0 720 460" role="group" aria-label={svgLabel(v)} set:html={v.svg}/></div>)}
{!poster && <cell-lab data-kind={KIND} data-highlight={HIGHLIGHT} data-interactive={interactive ? 'true' : undefined}>
<div class="workbench">
  <div class="canvas-pane">
    <div class="canvas-top">
      <span class="canvas-title"><span aria-hidden="true">◉</span> <span data-kind-title>{current.title}</span> <span class="badge">{spotlight ? 'SPOTLIGHT' : 'INTERACTIVE'}</span></span>
      {interactive ? <div class="pills cell-toggle" role="group" aria-label="Cell type">{views.map(v => <button type="button" class:list={['pill', { selected: v.kind === KIND }]} data-kind-toggle={v.kind} aria-pressed={v.kind === KIND}>{v.title}</button>)}</div> : <span class="canvas-hint">Click any organelle to open its page</span>}
    </div>
    {interactive && <noscript><style is:inline>cell-lab [data-cell][hidden],cell-lab [data-key][hidden],cell-lab [data-describe][hidden]{display:block!important}cell-lab .cell-toggle{display:none}</style>JavaScript is off, so the animal cell and the plant cell are both shown below; the toggle needs scripting. Every numbered organelle is still a link.</noscript>}
    {views.map(v => <div class="graph cell-stage" data-cell={v.kind} hidden={v.kind !== KIND}><svg viewBox="0 0 720 460" role="group" aria-label={svgLabel(v)} set:html={v.svg}/></div>)}
    <div class="graph-caption"><div class="legend"><span>Numbers match the key below</span>{spotlight && <span class="orange">Coral outline: {spotlight.title.toLowerCase()}</span>}</div><span>Not to scale: organelles are enlarged for clarity</span></div>
    {views.map(v => <ol class="cell-key" data-key={v.kind} hidden={v.kind !== KIND} aria-label={`${v.title} key`}>{v.items.map(item => <li>{item.slug ? <a href={`/cells/${item.slug}/`} data-key-item={item.slug} class:list={{ 'is-current': item.slug === HIGHLIGHT }} aria-current={item.slug === HIGHLIGHT ? 'page' : undefined}><span class="cell-num" style={`border-color:${item.color}`}>{item.n}</span><span class="cell-key-text"><strong>{item.name}</strong><small>{item.note}</small></span></a> : <span class="cell-key-extra"><span class="cell-num" style={`border-color:${item.color}`}>{item.n}</span><span class="cell-key-text"><strong>{item.name}</strong><small>{item.note}</small></span></span>}</li>)}</ol>)}
  </div>
  <div class="controls">
    {views.map(v => <div data-describe={v.kind} hidden={v.kind !== KIND}><h3>{v.title}: what you are looking at</h3><p class="small-note cell-lead">{v.description}</p>{v.extras.map(([name, desc]) => <p class="small-note"><strong>{name}.</strong> {desc}</p>)}</div>)}
    <div class="divider"></div>
    {spotlight
      ? <p class="small-note cell-lead">The <strong>{spotlight.title.toLowerCase()}</strong> is outlined in coral; it occurs in {spotlight.foundIn.map(s => s.toLowerCase()).join(', ')}. Hover or tab through the key to light up the other structures, and click any of them to open its page.</p>
      : <p class="small-note cell-lead">Hover or tab through the key to light up each structure. Every numbered organelle opens a page with its membranes, size, functions, a worked example, and a common misconception.</p>}
    {spotlight ? <a class="secondary full-width cell-cta" href="/cells/">Compare all eight organelles ↗</a> : <a class="secondary full-width cell-cta" href="/printable-diagrams/">Print a cell to label ↗</a>}
  </div>
</div>
</cell-lab>}
<style is:global>
cell-lab .cell-stage svg{max-height:560px;min-height:260px}
cell-lab .cell-stage svg text,.cell-poster svg text{font-family:'DM Sans',sans-serif}
cell-lab .cell-name,cell-lab .cell-stage text.cell-name,.cell-poster text.cell-name{paint-order:stroke;stroke:#fff;stroke-width:3.5px;stroke-linejoin:round}
cell-lab a[data-organelle]{cursor:pointer}
cell-lab a[data-organelle] .cell-shape{transition:stroke-width .15s,stroke .15s}
cell-lab a[data-organelle]:hover .cell-shape,cell-lab a[data-organelle]:focus-visible .cell-shape,cell-lab a[data-organelle].is-lit .cell-shape{stroke:#e2703a;stroke-width:4px}
cell-lab a[data-organelle]:hover,cell-lab a[data-organelle]:focus-visible,cell-lab a[data-organelle].is-lit{filter:drop-shadow(0 0 6px rgba(226,112,58,.55))}
cell-lab a[data-organelle]:focus-visible{outline:none}
cell-lab a[data-organelle][data-highlight]{filter:drop-shadow(0 0 7px rgba(226,112,58,.6))}
cell-lab .cell-toggle{gap:6px;flex-wrap:nowrap}
cell-lab .cell-toggle .pill{min-height:36px;white-space:nowrap}
cell-lab .cell-key{list-style:none;margin:0;padding:12px 18px 16px;display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:4px 12px;border-top:1px solid var(--line);background:#fff}
cell-lab .cell-key li{margin:0}
cell-lab .cell-key a,cell-lab .cell-key-extra{display:flex;align-items:center;gap:10px;padding:6px 10px;border-radius:9px;min-height:44px;transition:background .15s}
cell-lab .cell-key a:hover,cell-lab .cell-key a.is-lit,cell-lab .cell-key a:focus-visible{background:#fff1e8}
cell-lab .cell-key a.is-current{background:#e6f2e8}
cell-lab .cell-num{flex:0 0 26px;width:26px;height:26px;border-radius:50%;border:2px solid var(--green);display:grid;place-items:center;font-size:12px;font-weight:700;color:var(--ink);background:#fff}
cell-lab .cell-key-extra .cell-num{border-style:dashed}
cell-lab .cell-key-text{display:flex;flex-direction:column;line-height:1.3;min-width:0}
cell-lab .cell-key-text strong{font-size:14px;color:var(--ink)}
cell-lab .cell-key-text small{font-size:12px;color:var(--muted)}
cell-lab .controls h3{margin-bottom:10px}
cell-lab .controls .cell-lead{margin-top:0}
cell-lab .controls p strong{color:var(--ink)}
cell-lab .cell-cta{display:block;text-align:center;margin-top:18px;font-weight:600}
cell-lab noscript{margin:0;border-bottom:1px solid var(--line);font-size:14px}
@media(max-width:700px){cell-lab .canvas-top{flex-wrap:wrap}cell-lab .cell-key{grid-template-columns:1fr 1fr;padding:10px 12px 14px}cell-lab .cell-key a,cell-lab .cell-key-extra{padding:5px 6px;gap:8px}}
@media(max-width:460px){cell-lab .cell-key{grid-template-columns:1fr}}
@media print{cell-lab .cell-key{display:grid}cell-lab .controls{display:block!important;border:0}}
</style>
<script>
class CellLab extends HTMLElement {
  connectedCallback() {
    const buttons = Array.from(this.querySelectorAll<HTMLButtonElement>('[data-kind-toggle]'));
    const show = (kind: string) => {
      this.dataset.kind = kind;
      this.querySelectorAll<HTMLElement>('[data-cell],[data-key],[data-describe]').forEach(el => { const k = el.dataset.cell || el.dataset.key || el.dataset.describe; el.hidden = k !== kind; });
      buttons.forEach(b => { const on = b.dataset.kindToggle === kind; b.classList.toggle('selected', on); b.setAttribute('aria-pressed', String(on)); });
      const title = this.querySelector('[data-kind-title]');
      const active = buttons.find(b => b.dataset.kindToggle === kind);
      if (title && active) title.textContent = active.textContent;
    };
    buttons.forEach(b => b.addEventListener('click', () => show(b.dataset.kindToggle || 'animal')));
    // Hovering or focusing a key row lights up the matching organelle (in every pre-rendered cell), and vice versa.
    const groups = Array.from(this.querySelectorAll<SVGAElement>('a[data-organelle]'));
    const rows = Array.from(this.querySelectorAll<HTMLAnchorElement>('[data-key-item]'));
    const light = (slug: string | null) => {
      groups.forEach(g => g.classList.toggle('is-lit', g.dataset.organelle === slug));
      rows.forEach(r => r.classList.toggle('is-lit', r.dataset.keyItem === slug));
    };
    const wire = (el: Element, slug: string) => {
      el.addEventListener('mouseenter', () => light(slug));
      el.addEventListener('mouseleave', () => light(null));
      el.addEventListener('focus', () => light(slug));
      el.addEventListener('blur', () => light(null));
    };
    rows.forEach(r => wire(r, r.dataset.keyItem || ''));
    groups.forEach(g => wire(g, g.dataset.organelle || ''));
  }
}
customElements.define('cell-lab', CellLab);
</script>
