---
// Worked word problems as prerendered cards: the question as students phrase it, then the working and the answer.
interface Example { question: string; steps: string[]; answer: string; href?: string; label?: string }
// formula: the one equation the group of examples uses, shown under the heading.
interface Props { items: Example[]; title: string; intro?: string; id?: string; eyebrow?: string; formula?: string }
const { items = [], title, intro, id = 'worked-examples', eyebrow = 'Worked examples', formula } = Astro.props;
---
<section class="worked-section" aria-labelledby={`${id}-heading`} id={id}>
  <div class="section-heading"><div><div class="eyebrow">{eyebrow}</div><h2 id={`${id}-heading`}>{title}</h2>{intro && <p>{intro}</p>}</div></div>
  {formula && <div class="formula worked-formula">{formula}</div>}
  <div class="worked-grid">{items.map((item, i) => <article class="worked-card"><span class="worked-number">Example {i + 1}</span><h3>{item.question}</h3><ol>{item.steps.map(step => <li>{step}</li>)}</ol><p class="worked-answer"><strong>Answer:</strong> {item.answer}</p>{item.href && <a class="text-link" href={item.href}>{item.label} <span aria-hidden="true">↗</span></a>}</article>)}</div>
</section>
