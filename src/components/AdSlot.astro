---
// One ad space. Ads are switched off: while the unit keys in src/lib/ads.mjs are empty this renders
// nothing at all (no markup, no script, no reserved space). AdUnit.astro is the unit itself.
// type: 'leaderboard' (728×90 desktop / 320×50 phones) or 'rectangle' (300×250).
import AdUnit from './AdUnit.astro';
import { adsEnabled } from '../lib/ads.mjs';
interface Props { type?: 'leaderboard' | 'rectangle' }
const { type = 'leaderboard' } = Astro.props;
---
{adsEnabled[type] && <AdUnit type={type} />}
